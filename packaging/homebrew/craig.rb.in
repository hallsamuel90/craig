# Candidate for hallsamuel90/homebrew-tap/Formula/craig.rb. Not published.
# Unnotarized preview: ad-hoc signatures do not establish publisher identity.
class Craig < Formula
  desc "Local control plane for coding agents"
  homepage "https://craig-cli.com"
  version "@VERSION@"
  url "@URL@"
  sha256 "@SHA256@"
  license "MIT"

  depends_on :macos
  # Embedded Node has a 13.5 deployment minimum; avoid unsupported earlier Macs.
  # Use a conservative major-version bound until older hosts are qualified.
  on_macos do
    depends_on macos: :sonoma
  end
  depends_on arch: :arm64

  def install
    bin.install "craig"
    prefix.install "LICENSE", "THIRD_PARTY_NOTICES"
  end

  def caveats
    <<~EOS
      Check the release signing policy before installation. In an unnotarized
      preview, ad-hoc signatures are not Developer ID signing or notarization.
      See the Craig preview guide before accepting a Gatekeeper exception.
      Updates: brew upgrade hallsamuel90/tap/craig, then restart Craig manually.
    EOS
  end

  test do
    assert_match "Craig commands", shell_output("#{bin}/craig --help")
  end
end
