{
  "name": "craig",
  "version": "0.1.0",
  "private": true,
  "description": "Craig local control plane CLI",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "bin": {
    "craig": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "prestart": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^0.10.1",
    "picocolors": "^1.1.1",
    "terminal-kit": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^24.0.0",
    "@types/terminal-kit": "^2.5.7",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
