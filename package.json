{
  "name": "craig",
  "version": "0.1.0",
  "private": true,
  "description": "Craig local control plane CLI",
  "license": "MIT",
  "keywords": [
    "ai-coding",
    "agent-orchestration",
    "cli",
    "coding-agents",
    "developer-tools",
    "git-worktree",
    "local-first",
    "terminal-ui",
    "tui",
    "worktree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hallsamuel90/craig.git"
  },
  "bugs": {
    "url": "https://github.com/hallsamuel90/craig/issues"
  },
  "homepage": "https://github.com/hallsamuel90/craig#readme",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:npm": "node scripts/build-npm.mjs",
    "dev": "tsx src/cli.ts",
    "package:audit": "node scripts/package-audit.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prestart": "pnpm build",
    "security:socket": "socket ci",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^0.10.1",
    "picocolors": "^1.1.1",
    "terminal-kit": "^3.1.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.25.1",
    "@types/node": "^24.0.0",
    "@types/terminal-kit": "^2.5.7",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "socket": "^1.1.118",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^3.1.2"
  }
}
