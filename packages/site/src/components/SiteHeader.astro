---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { label: "Docs", href: "/docs/" },
  { label: "Blog", href: "/blog/" },
];
const current = (href: string) => {
  const section = href.replace(/\/$/, "");
  return pathname === section ? "page" : pathname.startsWith(`${section}/`) ? "location" : undefined;
};
---

<header class="site-header h-16 sticky top-0 z-50 border-b border-[#292e42] bg-[#0a0a0a]">
  <div class="w-full h-full px-4 sm:px-6 py-3 flex items-center justify-between gap-2">
    <div class="flex items-center gap-2 group shrink-0">
      <a href="/" class="text-[#9ece6a] font-bold text-base tracking-tight hover:opacity-80 transition-opacity" aria-label="Craig home">craig</a>
      <a
        href="/docs/quickstart/"
        class="opacity-[0.15] group-hover:opacity-90 focus-visible:opacity-90 transition-opacity duration-300 flex items-center"
        title="follow the white rabbit"
        aria-label="follow the white rabbit"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26 30" width="15" height="18" fill="white" aria-hidden="true">
          <ellipse cx="8" cy="5" rx="2" ry="6"/>
          <ellipse cx="12" cy="4" rx="1.8" ry="5.5"/>
          <circle cx="10" cy="14" r="5"/>
          <circle cx="15" cy="22" r="7.5"/>
          <circle cx="22" cy="18" r="2.5"/>
          <ellipse cx="8" cy="29" rx="3.5" ry="1.5"/>
          <ellipse cx="19" cy="29" rx="4" ry="1.5"/>
        </svg>
      </a>
    </div>
    <nav class="flex items-center gap-2 sm:gap-5 text-sm text-[#7a82ad]" aria-label="Main navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={current(link.href)} class="hover:text-[#c0caf5] transition-colors">{link.label}</a>
      ))}
      <a href="https://github.com/hallsamuel90/craig" class="flex items-center gap-1.5 hover:text-[#c0caf5] transition-colors" aria-label="GitHub">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
      <a href="/docs/install/" class="px-2.5 sm:px-3 py-1.5 bg-[#9ece6a] text-[#0a0a0a] font-bold rounded hover:opacity-90 transition-opacity text-[11px] sm:text-xs tracking-wide whitespace-nowrap">Get Started</a>
    </nav>
  </div>
</header>

<style>
  nav a[aria-current] { color: #c0caf5; }
</style>
