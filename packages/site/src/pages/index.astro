---
import Base from "../layouts/Base.astro";
import "../styles/global.css";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://craig-cli.com/#website",
      name: "Craig",
      alternateName: "Craig CLI",
      url: "https://craig-cli.com/",
    },
    {
      "@type": "SoftwareApplication",
      name: "Craig",
      url: "https://craig-cli.com/",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux",
      description: "Run Claude Code, Codex, and Cursor in isolated Git worktrees. Keep tasks, changes, pull requests, and checks together in one keyboard-driven terminal workspace.",
      downloadUrl: "https://www.npmjs.com/package/craig-cli",
      softwareRequirements: "Node.js 22 or newer",
      license: "https://opensource.org/license/mit",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
  ],
};
---

<Base
  title="Craig — Your coding agents, from task to PR, in one terminal"
  description="Run Claude Code, Codex, and Cursor in isolated Git worktrees. Keep tasks, changes, pull requests, and checks together in one keyboard-driven terminal workspace."
  structuredData={structuredData}
  preloadHeroImage
>

  <main>
    <!-- Hero -->
    <section class="max-w-4xl mx-auto px-6 pt-16 pb-10 text-center">
      <pre aria-hidden="true" class="block w-fit mx-auto -translate-x-[5%] text-[#9ece6a] text-[0.45rem] sm:text-[0.55rem] md:text-[0.65rem] leading-tight mb-6 select-none opacity-90">
  ▄████▄   ██▀███   ▄▄▄       ██▓  ▄████
  ▒██▀ ▀█  ▓██ ▒ ██▒▒████▄    ▓██▒ ██▒ ▀█▒
  ▒▓█    ▄ ▓██ ░▄█ ▒▒██  ▀█▄  ▒██▒▒██░▄▄▄░
  ▒▓▓▄ ▄██▒▒██▀▀█▄  ░██▄▄▄▄██ ░██░░▓█  ██▓
  ▒ ▓███▀ ░░██▓ ▒██▒ ▓█   ▓██▒░██░░▒▓███▀▒
  ░ ░▒ ▒  ░░ ▒▓ ░▒▓░ ▒▒   ▓▒█░░▓   ░▒   ▒
    ░  ▒     ░▒ ░ ▒░  ▒   ▒▒ ░ ▒ ░  ░   ░
  ░          ░░   ░   ░   ▒    ▒ ░░ ░   ░
  ░ ░         ░           ░  ░ ░        ░</pre>

      <p class="text-[#9ece6a] text-sm font-bold tracking-widest uppercase mb-4">Have fun. Get shit done.</p>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-tight mb-5">Your coding agents.<br />From task to PR. One terminal.</h1>
      <p class="text-[#a9adc4] text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-4">Run Claude Code, Codex, and Cursor in parallel, each task in its own Git worktree. Keep your agents, changes, pull requests, and checks together without leaving the keyboard.</p>
      <p class="text-[#7a82ad] text-xs sm:text-sm mb-7">An agnostic orchestrator TUI, for the people.</p>

      <div class="flex flex-wrap justify-center gap-3 mb-6 text-sm">
        <a href="/docs/quickstart/" class="px-4 py-2.5 bg-[#9ece6a] text-[#0a0a0a] font-bold rounded-lg hover:opacity-90 transition-opacity">Get started</a>
        <a href="https://github.com/hallsamuel90/craig" data-github-placement="hero" class="px-4 py-2.5 border border-[#737aa2] text-[#c0caf5] rounded-lg hover:border-[#9ece6a] transition-colors">View on GitHub ↗</a>
      </div>

      <div class="inline-flex items-center gap-3 bg-[#06060f] border border-[#292e42] rounded-lg px-5 py-3 mb-3">
        <span class="text-[#7a82ad] select-none">$</span>
        <code class="text-[#9ece6a] text-sm tracking-wide">npm install -g craig-cli</code>
        <button
          class="text-[#7a82ad] hover:text-[#c0caf5] transition-colors ml-1 text-base"
          title="Copy"
          aria-label="Copy npm install command"
          onclick="navigator.clipboard.writeText('npm install -g craig-cli').then(() => { window.gtag?.('event', 'install_command_copy', { method: 'npm', placement: 'homepage_hero' }); this.textContent = '✓'; setTimeout(() => this.textContent = '⎘', 1200) })"
        >⎘</button>
      </div>
      <p class="text-[#a9adc4] text-xs">Node 22+ · MIT · No Craig account required</p>
    </section>

    <!-- Hero video -->
    <section id="demo" aria-label="Craig demo" class="max-w-[1440px] mx-auto px-6 pb-12">
      <p class="text-[#a9adc4] text-sm text-center mb-5">It's like a game, except the PRs are real.</p>
      <div class="rounded-xl overflow-hidden border border-[#292e42]" style="aspect-ratio: 1676 / 1074">
        <video controls muted playsinline preload="none" width="1676" height="1074" poster="/craig-hero-poster.jpg" aria-label="Watch Craig go from splash screen to a merged pull request" class="w-full block">
          <source src="/craig-hero.mp4?v=4" type="video/mp4" />
          <a href="/craig-hero.mp4?v=4">Watch the Craig demo</a>
        </video>
      </div>
      <p class="text-[#a9adc4] text-xs text-center mt-3">From splash screen to merged PR · 1 min 5 sec · CI waits trimmed.</p>
    </section>

    <section aria-labelledby="workflow-heading" class="max-w-6xl mx-auto px-6 py-12 sm:py-16 border-t border-[#292e42]">
      <p class="text-[#9ece6a] text-xs uppercase tracking-widest mb-3">The workflow</p>
      <h2 id="workflow-heading" class="text-2xl sm:text-3xl font-bold mb-10">More work moving. Less tab hunting.</h2>
      <div class="grid md:grid-cols-3 gap-8 md:gap-10">
        <div>
          <p class="text-[#9ece6a] text-xs mb-3">01 / Start another task</p>
          <h3 class="text-lg font-bold mb-3">Parallel agents. Separate worktrees.</h3>
          <p class="text-[#a9adc4] text-sm leading-relaxed mb-4">Give one agent a bug and another a feature. Craig creates a branch and worktree for each task, so they can work side by side in separate working directories.</p>
          <a href="/docs/quickstart/" class="text-[#9ece6a] text-sm underline underline-offset-4">Create your first task →</a>
        </div>
        <div>
          <p class="text-[#7aa2f7] text-xs mb-3">02 / Keep your bearings</p>
          <h3 class="text-lg font-bold mb-3">One repo, or a few.</h3>
          <p class="text-[#a9adc4] text-sm leading-relaxed mb-4">Work across your frontend, API, and other repos from one workspace. Switch tasks from the keyboard and return to the agent's native CLI when it needs you.</p>
          <a href="/docs/tui/" class="text-[#9ece6a] text-sm underline underline-offset-4">Explore the controls →</a>
        </div>
        <div>
          <p class="text-[#e0af68] text-xs mb-3">03 / Follow it through</p>
          <h3 class="text-lg font-bold mb-3">Changes, PRs, and checks in view.</h3>
          <p class="text-[#a9adc4] text-sm leading-relaxed mb-4">Inspect files and diffs while Craig syncs pull request and check status. Ask your agent to commit, open the PR, or merge from the same terminal session.</p>
          <a href="/docs/tui/" class="text-[#9ece6a] text-sm underline underline-offset-4">See the review workflow →</a>
        </div>
      </div>
      <figure class="mt-10">
        <div class="rounded-xl overflow-hidden border border-[#292e42]">
          <img src="/screenshots/ci-review.png" alt="Craig showing a task's coding agent alongside its pull request and CI checks in the Review panel" width="1440" height="694" loading="lazy" decoding="async" class="w-full block" />
        </div>
        <figcaption class="text-[#a9adc4] text-xs text-center mt-3">The agent and its PR status, in the same workspace.</figcaption>
      </figure>
    </section>

    <section aria-labelledby="why-heading" class="max-w-6xl mx-auto px-6 py-12 sm:py-16 border-t border-[#292e42]">
      <div class="grid md:grid-cols-[1fr_1.3fr] gap-8 md:gap-16">
        <div>
          <p class="text-[#9ece6a] text-xs uppercase tracking-widest mb-3">Why Craig?</p>
          <h2 id="why-heading" class="text-2xl sm:text-3xl font-bold leading-snug">You like your agent CLIs.<br />Keep them.</h2>
        </div>
        <div class="space-y-7 text-sm leading-relaxed">
          <div><h3 class="text-base font-bold mb-2">A heads-up display around the tools you use.</h3><p class="text-[#a9adc4]">Your agents run in real terminal sessions, with their own prompts, tools, and authentication. Craig adds task navigation, worktree management, and review context around them.</p></div>
          <div><h3 class="text-base font-bold mb-2">Your workspace, on your machine.</h3><p class="text-[#a9adc4]">Craig runs locally, in your existing terminal. No Craig account or hosted control plane. Install and authenticate your agent CLIs, then bring them along.</p></div>
          <div><h3 class="text-base font-bold mb-2">Your agents can drive Craig, too.</h3><p class="text-[#a9adc4]">The TUI has a CLI behind it. Agents and scripts can inspect task context, create tasks, and operate the workspace using the same task model.</p><a href="/docs/cli/" class="inline-block text-[#9ece6a] underline underline-offset-4 mt-3">Read the CLI reference →</a></div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-6 pt-12 pb-20 text-center border-t border-[#292e42]">
      <p class="text-[#9ece6a] text-xs font-bold tracking-widest uppercase mb-4">Open source · MIT · One command</p>
      <h2 class="text-2xl font-bold text-[#c0caf5] mb-3">Your move.</h2>
      <p class="text-[#a9adc4] text-sm mb-8">Install Craig. Add a repo. Give your agent something to do.</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/docs/install/" class="px-5 py-2.5 bg-[#9ece6a] text-[#0a0a0a] font-bold rounded-lg hover:opacity-90 transition-opacity tracking-wide text-sm">
          Get Started
        </a>
        <a href="https://github.com/hallsamuel90/craig" data-github-placement="footer_cta" class="px-5 py-2.5 border border-[#737aa2] text-[#c0caf5] rounded-lg hover:border-[#9ece6a] transition-colors text-sm">
          View on GitHub
        </a>
      </div>
      <p class="text-[#a9adc4] text-xs mt-5">Requires Node.js 22+, Git, and an authenticated agent CLI. PR features also use GitHub CLI.</p>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-[#292e42] px-6 py-6 text-center text-[#737aa2] text-xs">
    MIT License · <a href="https://github.com/hallsamuel90/craig" class="hover:text-[#c0caf5] transition-colors">GitHub</a>
  </footer>

</Base>

<script is:inline>
  document.querySelectorAll('[data-github-placement]').forEach((link) => {
    link.addEventListener('click', () => {
      window.gtag?.('event', 'github_click', { placement: link.dataset.githubPlacement });
    });
  });
</script>
