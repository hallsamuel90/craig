---
interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title = "Craig - Run AI coding agents in parallel",
  description = "Craig is a local terminal UI for running Codex, Claude Code, and Cursor agents in parallel across isolated Git worktrees.",
  structuredData,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/screenshots/agent-working.png", Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QSY1NHN41" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6QSY1NHN41');
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" sizes="256x256" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Craig" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Craig terminal UI running an AI coding agent" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Craig terminal UI running an AI coding agent" />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class="bg-[#0a0a0a] text-[#c0caf5] font-mono min-h-screen">
    <slot />
  </body>
</html>
