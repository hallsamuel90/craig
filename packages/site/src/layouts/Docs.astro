---
import Base from "./Base.astro";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}
const title = Astro.props.title ?? Astro.props.frontmatter?.title;
const description = Astro.props.description ?? Astro.props.frontmatter?.description;

const nav = [
  { label: "Overview", href: "/docs/" },
  { label: "Install", href: "/docs/install/" },
  { label: "Quickstart", href: "/docs/quickstart/" },
  { label: "TUI Reference", href: "/docs/tui/" },
  { label: "Runners", href: "/docs/runners/" },
  { label: "Config", href: "/docs/config/" },
  { label: "CLI Reference", href: "/docs/cli/" },
  { label: "Agent Orchestration", href: "/docs/orchestration/" },
  { label: "Fury Quickstart", href: "/docs/fury-quickstart/" },
];

const currentPath = Astro.url.pathname;
---

<Base title={title ? `${title} - Craig Docs` : "Craig Documentation"} description={description}>
  <div class="flex flex-col md:flex-row min-h-[calc(100dvh-4rem)]">
    <!-- Sidebar -->
    <aside class="w-full md:w-52 shrink-0 border-b md:border-b-0 md:border-r border-[#292e42] p-5 md:sticky md:top-16 md:h-[calc(100dvh-4rem)] overflow-y-auto">
      <nav class="flex flex-wrap md:block gap-1 md:space-y-0.5" aria-label="Documentation navigation">
        <p class="w-full text-xs text-[#7a82ad] uppercase tracking-widest mb-2">Docs</p>
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath.replace(/\/$/, "") === item.href.replace(/\/$/, "") ? "page" : undefined}
            class={`block px-2.5 py-1.5 rounded text-sm transition-colors ${
              currentPath.replace(/\/$/, "") === item.href.replace(/\/$/, "")
                ? "bg-[#1a1b26] text-[#c0caf5]"
                : "text-[#7a82ad] hover:text-[#c0caf5] hover:bg-[#1a1b26]/50"
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </aside>

    <!-- Content -->
    <main class="flex-1 min-w-0 py-10 overflow-y-auto">
      <slot />
    </main>
  </div>
</Base>
